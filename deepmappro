class ReportEngine:
    """
    Toplanan tüm verileri:
    - report.json
    - findings.json
    - asset_inventory.json
    - manifest.json
    - report.txt
    - report.csv
    - report.html (XSS korumalı html.escape ile)
    olarak tek klasöre kaydeder.
    """

    def __init__(self, store: ResultStore, logger: logging.Logger):
        self.store = store
        self.logger = logger
        self.saved = False

    def save_all(self, final_status: str):
        if self.saved:
            return
        self.saved = True
        self.store.end_time = datetime.now()
        self.store.status = final_status

        scan_dir = self.store.scan_dir
        paths = {
            "report_json": os.path.join(scan_dir, "report.json"),
            "findings_json": os.path.join(scan_dir, "findings.json"),
            "inventory_json": os.path.join(scan_dir, "asset_inventory.json"),
            "manifest_json": os.path.join(scan_dir, "manifest.json"),
            "report_txt": os.path.join(scan_dir, "report.txt"),
            "report_csv": os.path.join(scan_dir, "report.csv"),
            "report_html": os.path.join(scan_dir, "report.html"),
        }

        summary_meta = {
            "scan_id": self.store.scan_id,
            "target": self.store.target,
            "profile": self.store.profile_name,
            "speed": self.store.speed_name,
            "start_time": self.store.start_time.strftime("%Y-%m-%d %H:%M:%S"),
            "end_time": self.store.end_time.strftime("%Y-%m-%d %H:%M:%S"),
            "duration_seconds": round((self.store.end_time - self.store.start_time).total_seconds(), 2),
            "status": self.store.status,
            "active_tests_authorized": self.store.active_tests_authorized,
            "total_live_hosts": len(self.store.assets),
            "total_findings": len(self.store.findings),
            "total_errors": len(self.store.errors)
        }

        # 1. Birleşik report.json
        unified_report = {
            "scan_info": summary_meta,
            "environment": self.store.environment_info,
            "assets": self.store.assets,
            "findings": self.store.findings,
            "tasks": self.store.tasks,
            "errors": self.store.errors
        }
        self._write_json(paths["report_json"], unified_report)

        # 2. findings.json
        self._write_json(paths["findings_json"], {
            "scan_id": self.store.scan_id,
            "total_findings": len(self.store.findings),
            "findings": self.store.findings
        })

        # 3. asset_inventory.json
        self._write_json(paths["inventory_json"], {
            "scan_id": self.store.scan_id,
            "total_assets": len(self.store.assets),
            "assets": list(self.store.assets.values())
        })

        # 4. manifest.json
        self._write_json(paths["manifest_json"], {
            "scan_info": summary_meta,
            "tools": self.store.environment_info.get("tools", {}),
            "tasks": self.store.tasks,
            "errors": self.store.errors
        })

        # 5. report.csv
        self._write_csv(paths["report_csv"])

        # 6. report.txt
        self._write_txt(paths["report_txt"], summary_meta)

        # 7. report.html (HTML-Escape Korumalı)
        self._write_html(paths["report_html"], summary_meta)

        print(f"\n{Colors.GREEN}{Colors.BOLD}[✓] MERKEZİ PROJE VE RAPOR PAKETİ KAYDEDİLDİ:{Colors.ENDC}")
        print(f"    📂 Proje Klasörü : {Colors.BOLD}{scan_dir}{Colors.ENDC}")
        print(f"    ├── Birleşik JSON: {paths['report_json']}")
        print(f"    ├── HTML Raporu  : {paths['report_html']}")
        print(f"    ├── TXT Raporu   : {paths['report_txt']}")
        print(f"    ├── CSV Envanter : {paths['report_csv']}")
        print(f"    ├── Bulgular     : {paths['findings_json']}")
        print(f"    ├── Varlıklar    : {paths['inventory_json']}")
        print(f"    └── Manifest/Log : {paths['manifest_json']}")

    def _write_json(self, path: str, data: Any):
        try:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except Exception as exc:
            self.logger.error(f"JSON yazma hatası ({path}): {exc}")

    def _write_csv(self, path: str):
        try:
            with open(path, "w", encoding="utf-8", newline="") as f:
                writer = csv.writer(f)
                writer.writerow([
                    "IP", "Hostname", "MAC", "Vendor", "OS", "Port", "Protocol",
                    "State", "Service", "Product", "Version", "Sources"
                ])
                for ip, asset in self.store.assets.items():
                    os_top = asset["os_matches"][0]["name"] if asset["os_matches"] else "Bilinmiyor"
                    if not asset["ports"]:
                        writer.writerow([
                            ip, asset["hostname"], asset["mac"], asset["vendor"],
                            os_top, "-", "-", "up", "-", "-", "-", ",".join(asset["discovery_sources"])
                        ])
                    else:
                        for p in asset["ports"]:
                            writer.writerow([
                                ip, asset["hostname"], asset["mac"], asset["vendor"],
                                os_top, p["port"], p["protocol"], p["state"],
                                p["service"], p["product"], p["version"], ",".join(p.get("sources", []))
                            ])
        except Exception as exc:
            self.logger.error(f"CSV yazma hatası ({path}): {exc}")

    def _write_txt(self, path: str, meta: Dict[str, Any]):
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write("=" * 78 + "\n")
                f.write("DEEPNETMAPPER PRO - BİRLEŞİK AĞ KEŞİF VE GÜVENLİK DENETİM RAPORU\n")
                f.write("=" * 78 + "\n")
                f.write(f"Tarama Kimliği : {meta['scan_id']}\n")
                f.write(f"Hedef Kapsamı  : {meta['target']}\n")
                f.write(f"Profil / Hız   : {meta['profile']} | {meta['speed']}\n")
                f.write(f"Başlangıç/Bitiş: {meta['start_time']} -> {meta['end_time']} ({meta['duration_seconds']} sn)\n")
                f.write(f"Tarama Durumu  : {meta['status']}\n")
                f.write(f"Aktif Cihazlar : {meta['total_live_hosts']} | Bulgular: {meta['total_findings']}\n")
                f.write("=" * 78 + "\n\n")

                for ip, data in self.store.assets.items():
                    f.write(f"[CİHAZ] {data['ip']} ({data['hostname']})\n")
                    f.write(f"  MAC / Üretici  : {data['mac']} ({data['vendor']})\n")
                    f.write(f"  Keşif Kaynağı  : {', '.join(data['discovery_sources'])}\n")
                    if data["os_matches"]:
                        os_str = ", ".join(f"{o['name']} (%{o['accuracy']})" for o in data["os_matches"][:3])
                        f.write(f"  OS Tahminleri  : {os_str}\n")
                    if data["ports"]:
                        f.write("  Açık Portlar   :\n")
                        for p in data["ports"]:
                            svc = f"{p['service']} {p['product']} {p['version']} {p['extrainfo']}".strip()
                            f.write(f"    - {p['port']}/{p['protocol']:<5} {p['state']:<8} {svc}\n")
                    f.write("\n" + "-" * 60 + "\n")

                if self.store.findings:
                    f.write("\n" + "=" * 78 + "\n")
                    f.write("GÜVENLİK VE YAPILANDIRMA BULGULARI\n")
                    f.write("=" * 78 + "\n")
                    for fn in self.store.findings:
                        port_info = f":{fn['port']}" if fn["port"] else ""
                        f.write(f"[{fn['severity']}] {fn['id']} - {fn['title']} ({fn['asset_ip']}{port_info})\n")
                        f.write(f"  Kategori : {fn['category']} | Araç: {fn['tool']}\n")
                        f.write(f"  Kanıt    : {fn['evidence']}\n")
                        f.write(f"  Öneri    : {fn['remediation']}\n\n")
        except Exception as exc:
            self.logger.error(f"TXT yazma hatası ({path}): {exc}")

