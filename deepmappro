                        asset_ip=ip,
                        port=port_num,
                        title=title,
                        severity=sev,
                        category="Exposed Service",
                        evidence=f"Açık Port: {port_num}/{p['protocol']} | Servis: {svc_desc}",
                        remediation=rem,
                        tool="service-correlator"
                    )


