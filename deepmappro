# 5. MODÜLLER: KEŞİF, NMAP, DNS, WEB, TLS, ZAFİYET (modules/*.py)
# =====================================================================
class DiscoveryModule:
    """Yerel ağ arayüzlerini, yönlendirme tablosunu, Wi-Fi ortamını ve ARP/Ping keşfini yönetir."""

    def __init__(self, store: ResultStore, proc_mgr: ProcessManager, tool_mgr: ToolManager, logger: logging.Logger):
        self.store = store
        self.proc_mgr = proc_mgr
        self.tool_mgr = tool_mgr
        self.logger = logger

    def inspect_local_environment(self) -> List[Dict[str, str]]:
        """Yerel arayüzleri (ip addr), yönlendirmeleri (ip route) ve Wi-Fi ağlarını (nmcli) toplar."""
        discovered_subnets: List[Dict[str, str]] = []

        # 1. ip -o -4 addr show
        if self.tool_mgr.is_available("ip"):
            out, _, rc, _ = self.proc_mgr.run_command(
                "discovery", "ip", ["ip", "-o", "-4", "addr", "show"], timeout=10
            )
            if rc == 0:
                for line in out.splitlines():
                    parts = line.split()
                    if len(parts) >= 4:
                        iface = parts[1]
                        cidr = parts[3]
                        if iface != "lo" and "/" in cidr:
                            try:
                                net = str(ipaddress.ip_network(cidr, strict=False))
                            except ValueError:
                                net = cidr
                            entry = {"type": "Yerel Alt Ağ (Interface)", "name": iface, "target": net, "ip_cidr": cidr}
                            self.store.environment_info["interfaces"].append(entry)
                            discovered_subnets.append(entry)

            # 2. ip route
            r_out, _, r_rc, _ = self.proc_mgr.run_command(
                "discovery", "ip", ["ip", "route", "show"], timeout=10
            )
            if r_rc == 0:
                self.store.environment_info["routes"] = [
                    line.strip() for line in r_out.splitlines() if line.strip()
                ]

        # 3. nmcli Wi-Fi keşfi (Kaçışlı '\:' karakterlerini bozmadan ayrıştırır)
        if self.tool_mgr.is_available("nmcli"):
            w_out, _, w_rc, _ = self.proc_mgr.run_command(
                "discovery",
                "nmcli",
                ["nmcli", "-t", "-e", "yes", "-f", "ACTIVE,SSID,BSSID,CHAN,SIGNAL", "dev", "wifi"],
                timeout=8
            )
            if w_rc == 0:
                for line in w_out.splitlines():
                    if not line.strip():
                        continue
                    fields = [f.replace("\\:", ":").replace("\\\\", "\\") for f in re.split(r"(?<!\\):", line)]
                    if len(fields) >= 5:
                        active, ssid, bssid, chan, signal_lvl = fields[:5]
                        ssid_clean = ssid.strip() or "<Gizli SSID>"
                        self.store.environment_info["wifi_networks"].append({
                            "active": active,
                            "ssid": ssid_clean,
                            "bssid": bssid,
                            "channel": chan,
                            "signal": signal_lvl
                        })

        return discovered_subnets

    def run_arp_scan(self, target: str):
        """Yerel alt ağ hedeflerinde arp-scan ile Katman-2 keşfi yapar."""
        if not self.tool_mgr.is_available("arp-scan"):
            self.store.record_task("discovery", "arp-scan", ["arp-scan"], "SKIPPED", None, 0.0, error_msg="arp-scan kurulu değil")
            return

        valid, t_type, _ = ScopeValidator.validate_target(target)
        if not valid or t_type not in ("cidr", "ip_range"):
            return

        print(f"{Colors.BLUE}[*] Katman-2 ARP Öncül Keşfi çalıştırılıyor (arp-scan)...{Colors.ENDC}")
        out, _, _, _ = self.proc_mgr.run_command(
            module_name="discovery",
            tool_name="arp-scan",
            cmd=[self.tool_mgr.get_binary("arp-scan"), target],
            timeout=30,
            raw_category="nmap",
            raw_filename="arp_scan_raw.txt"
        )
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) >= 2:
                ip_candidate = parts[0].strip()
                mac_candidate = parts[1].strip()
                vendor = parts[2].strip() if len(parts) > 2 else "Bilinmiyor"
                is_ip, _, _ = ScopeValidator.validate_target(ip_candidate)
                if is_ip:
                    self.store.upsert_asset(
                        ip=ip_candidate,
                        mac=mac_candidate,
                        vendor=vendor,
                        source="arp-scan"
                    )


class NmapScannerModule:
    """Nmap keşif, derin port/servis taraması, XML ayrıştırma ve Ctrl+C kısmi veri kurtarma modülü."""

    def __init__(self, store: ResultStore, proc_mgr: ProcessManager, tool_mgr: ToolManager, logger: logging.Logger):
        self.store = store
        self.proc_mgr = proc_mgr
        self.tool_mgr = tool_mgr
        self.logger = logger
        self.xml_files: List[str] = []

    def discover_live_hosts(self, target: str) -> List[str]:
        """Aşama 1: Nmap Ping/ARP/ICMP keşfi ile canlı cihazları belirler."""
        xml_path = os.path.join(self.store.raw_dirs["nmap"], "01_host_discovery.xml")
        self.xml_files.append(xml_path)

        cmd = ["nmap", "-sn", "-PE", "-PP", "-PM", "-T4", "-oX", xml_path, target]
        print(f"{Colors.BLUE}[*] Nmap Canlı Cihaz Keşfi: {' '.join(cmd)}{Colors.ENDC}")

        self.proc_mgr.run_command(
            module_name="nmap_discovery",
            tool_name="nmap",
            cmd=cmd,
            timeout=180,
            raw_category="nmap",
            raw_filename="01_host_discovery_stdout.txt"
        )

        self.parse_and_recover_xml(xml_path, source_tag="nmap-discovery")
        return list(self.store.assets.keys())

    def scan_hosts(self, live_ips: List[str], profile_flags: List[str], speed_flags: List[str], host_timeout_sec: int = 600):
        """Aşama 2: Aktif cihazları seçilen profil ve hız bayraklarıyla tarar."""
        is_root = (os.geteuid() == 0) if hasattr(os, "geteuid") else False
        effective_flags = self.tool_mgr.resolve_nmap_flags(profile_flags, speed_flags, is_root=is_root)

        # Profil 1 (-sn) ise yalnızca topoloji / traceroute tamamlanır
        if "-sn" in effective_flags:
            print(f"\n{Colors.CYAN}[*] Hızlı Keşif profili (-sn): Port taraması yapılmadan topoloji haritalanıyor...{Colors.ENDC}")
            topo_xml = os.path.join(self.store.raw_dirs["nmap"], "02_topology_only.xml")
            self.xml_files.append(topo_xml)
            cmd = ["nmap"] + effective_flags + ["-oX", topo_xml] + live_ips
            self.proc_mgr.run_command(
                module_name="nmap_topology",
                tool_name="nmap",
                cmd=cmd,
                timeout=host_timeout_sec,
                raw_category="nmap",
                raw_filename="02_topology_stdout.txt"
            )
            self.parse_and_recover_xml(topo_xml, source_tag="nmap-topology")
            for ip in live_ips:
                self.store.ensure_asset(ip)["scan_completed"] = True
            return

        print(f"\n{Colors.CYAN}{Colors.BOLD}[AŞAMA 2] Derin Servis ve Port Analizi Başlatılıyor...{Colors.ENDC}")
        print(f"{Colors.WARNING}[i] İpucu: 'Ctrl+C' ile durdurduğunuzda o ana kadar bulunan tüm açık portlar ve XML verileri kurtarılır.{Colors.ENDC}\n")

        total = len(live_ips)
        for idx, ip in enumerate(live_ips, start=1):
            if self.proc_mgr.is_interrupted:
                break

            safe_ip = ip.replace(".", "_").replace(":", "_")
            host_xml = os.path.join(self.store.raw_dirs["nmap"], f"host_{safe_ip}.xml")
            self.xml_files.append(host_xml)

            cmd = ["nmap"] + effective_flags + ["--stats-every", "5s", "-oX", host_xml, ip]
            print(f"{Colors.BOLD}[{idx}/{total}] Hedef Taranıyor: {ip}{Colors.ENDC}")
            print(f"    Komut: {' '.join(cmd)}")

            _, _, _, status = self.proc_mgr.run_command(
                module_name="nmap_deep_scan",
                tool_name="nmap",
                cmd=cmd,
                timeout=host_timeout_sec,
                raw_category="nmap",
                raw_filename=f"host_{safe_ip}_stdout.txt",
                stream_output=True
            )

            self.parse_and_recover_xml(host_xml, source_tag="nmap-deep", expected_ip=ip)
            asset = self.store.ensure_asset(ip)
            if status == "COMPLETED":
                asset["scan_completed"] = True
            else:
                asset["partial_recovery"] = True

            print(f"    {Colors.GREEN}[✓] {ip} işlendi ({len(asset['ports'])} açık port kayıtlı, Durum: {status}).{Colors.ENDC}\n")

    def recover_all_pending_xmls(self):
        """Kesinti (Ctrl+C) sonrasında tüm XML dosyalarını yeniden okuyup kurtarır."""
        for xml_file in self.xml_files:
            if os.path.exists(xml_file):
                self.parse_and_recover_xml(xml_file, source_tag="nmap-interrupted-recovery")

    def parse_and_recover_xml(self, xml_path: str, source_tag: str = "nmap", expected_ip: Optional[str] = None):
        """
        Nmap XML çıktısını ayrıştırır.
        Yarım kalmış (bozuk) XML dosyalarında:
          1. Tamamlanmış <host>...</host> bloklarını onararak ElementTree ile okur.
          2. Kapanmamış son <host> bloğundaki açık portları düzenli ifadelerle (fallback) kurtarır.
        """
        if not os.path.exists(xml_path) or os.path.getsize(xml_path) == 0:
            return

        try:
            with open(xml_path, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
        except Exception as exc:
            self.logger.error(f"XML okuma hatası ({xml_path}): {exc}")
            self.store.record_error("xml_parser", f"XML okunamadı: {xml_path}", str(exc))
            return

        if not content.strip():
            return

        trailing_fragment = ""
        if "</nmaprun>" not in content:
            self.logger.warning(f"Tamamlanmamış XML tespit edildi, kurtarma uygulanıyor: {os.path.basename(xml_path)}")
            last_host_end = content.rfind("</host>")
            if last_host_end != -1:
                trailing_fragment = content[last_host_end + len("</host>"):]
                content = content[:last_host_end + len("</host>")] + "\n</nmaprun>"
            else:
                trailing_fragment = content
                content = ""

        if content:
            try:
                root = ET.fromstring(content)
                for host_elem in root.findall("host"):
                    self._parse_host_element(host_elem, source_tag)
            except ET.ParseError as exc:
                self.logger.warning(f"XML ElementTree onarımı başarısız, yedek ayrıştırıcıya geçiliyor: {exc}")
                trailing_fragment = content + "\n" + trailing_fragment

        if trailing_fragment.strip():
            self._Fallback_regex_recovery(trailing_fragment, expected_ip, source_tag)

    def _parse_host_element(self, host: ET.Element, source_tag: str):
        status_elem = host.find("status")
        if status_elem is not None and status_elem.get("state") not in ("up", None):
            return

        ip_addr = None
        mac_addr = None
        vendor = None
        for addr in host.findall("address"):
            atype = addr.get("addrtype")
            if atype in ("ipv4", "ipv6"):
                ip_addr = addr.get("addr")
            elif atype == "mac":
                mac_addr = addr.get("addr")
                vendor = addr.get("vendor")

        if not ip_addr:
            return

        hostname = None
        hostnames_elem = host.find("hostnames")
        if hostnames_elem is not None:
            hn_elem = hostnames_elem.find("hostname")
            if hn_elem is not None and hn_elem.get("name"):
                hostname = hn_elem.get("name")

        self.store.upsert_asset(ip=ip_addr, hostname=hostname, mac=mac_addr, vendor=vendor, source=source_tag)
        asset = self.store.ensure_asset(ip_addr)

        # OS tahminleri
        os_elem = host.find("os")
        if os_elem is not None:
            for osmatch in os_elem.findall("osmatch"):
                os_name = osmatch.get("name")
                os_acc = osmatch.get("accuracy", "0")
                entry = {"name": os_name, "accuracy": os_acc}
                if os_name and entry not in asset["os_matches"]:
                    asset["os_matches"].append(entry)

        # Portlar ve port seviyesi NSE scriptleri
        ports_elem = host.find("ports")
        if ports_elem is not None:
            for port in ports_elem.findall("port"):
                port_id_str = port.get("portid", "0")
                if not port_id_str.isdigit():
                    continue
                port_id = int(port_id_str)
                protocol = port.get("protocol", "tcp")

                state_elem = port.find("state")
                state = state_elem.get("state", "bilinmiyor") if state_elem is not None else "bilinmiyor"
                if state != "open":
                    continue

                service_elem = port.find("service")
                service_name = service_elem.get("name", "bilinmiyor") if service_elem is not None else "bilinmiyor"
                product = service_elem.get("product", "") if service_elem is not None else ""
                version = service_elem.get("version", "") if service_elem is not None else ""
                extrainfo = service_elem.get("extrainfo", "") if service_elem is not None else ""

                self.store.upsert_port(
                    ip=ip_addr,
                    port=port_id,
                    protocol=protocol,
                    state=state,
                    service=service_name,
                    product=product,
                    version=version,
                    extrainfo=extrainfo,
                    source=source_tag
                )

                for scr in port.findall("script"):
                    s_id = scr.get("id", "unknown-script")
                    s_out = scr.get("output", "")
                    scr_record = {"port": port_id, "id": s_id, "output": s_out}
                    if scr_record not in asset["scripts"]:
                        asset["scripts"].append(scr_record)
                    self._correlate_nse_finding(ip_addr, port_id, s_id, s_out)

        # Host seviyesi NSE scriptleri
        hostscript_elem = host.find("hostscript")
        if hostscript_elem is not None:
            for scr in hostscript_elem.findall("script"):
                s_id = scr.get("id", "host-script")
                s_out = scr.get("output", "")
                scr_record = {"port": None, "id": s_id, "output": s_out}
                if scr_record not in asset["scripts"]:
                    asset["scripts"].append(scr_record)
                self._correlate_nse_finding(ip_addr, None, s_id, s_out)

        # Traceroute
        trace_elem = host.find("trace")
        if trace_elem is not None:
            hops = []
            for hop in trace_elem.findall("hop"):
                hops.append({
                    "ttl": hop.get("ttl", ""),
                    "ip": hop.get("ipaddr", ""),
                    "host": hop.get("host", ""),
                    "rtt": hop.get("rtt", "")
                })
            if hops:
                asset["traceroute"] = hops

    def _Fallback_regex_recovery(self, fragment: str, expected_ip: Optional[str], source_tag: str):
        """Kapanmamış XML parçacığından IP, MAC ve açık portları kurtarır."""
        ip_match = re.search(r'<address addr="([^"]+)" addrtype="ipv4"', fragment)
        ip_addr = ip_match.group(1) if ip_match else expected_ip
        if not ip_addr:
            return

        mac_match = re.search(r'<address addr="([^"]+)" addrtype="mac"(?: vendor="([^"]*)")?', fragment)
        mac_addr = mac_match.group(1) if mac_match else None
        vendor = mac_match.group(2) if (mac_match and mac_match.group(2)) else None

        self.store.upsert_asset(ip=ip_addr, mac=mac_addr, vendor=vendor, source=f"{source_tag}-partial")
        asset = self.store.ensure_asset(ip_addr)
        asset["partial_recovery"] = True

        port_pattern = re.compile(
            r'<port protocol="(tcp|udp)" portid="(\d+)">\s*<state state="open"[^/]*/>'
            r'(?:\s*<service name="([^"]*)"(?: product="([^"]*)")?(?: version="([^"]*)")?)?',
            re.DOTALL
        )
        for m in port_pattern.finditer(fragment):
            proto, pid, svc, prod, ver = m.groups()
            self.store.upsert_port(
                ip=ip_addr,
                port=int(pid),
                protocol=proto,
                state="open",
                service=svc or "bilinmiyor",
                product=prod or "",
                version=ver or "",
                source=f"{source_tag}-partial"
            )

    def _correlate_nse_finding(self, ip: str, port: Optional[int], script_id: str, output: str):
        """NSE script çıktılarını inceleyerek güvenlik bulgularına dönüştürür."""
        if not output:
            return
        upper_out = output.upper()
        if "VULNERABLE" in upper_out and "NOT VULNERABLE" not in upper_out:
            self.store.add_finding(
                asset_ip=ip,
                port=port,
                title=f"NSE Zafiyet Göstergesi: {script_id}",
                severity="HIGH",
                category="NSE Vulnerability Check",
                evidence=output,
                remediation="İlgili servis sürümünü güncelleyin ve NSE çıktısındaki CVE/yapılandırma detaylarını doğrulayın.",
                tool="nmap-nse"
            )
        elif any(k in script_id for k in ("smb-security-mode", "ftp-anon", "http-title", "ssh2-enum-algos")):
            if "Anonymous FTP login allowed" in output:
                self.store.add_finding(
                    asset_ip=ip,
                    port=port,
                    title="Anonim FTP Girişi Aktif",
                    severity="MEDIUM",
                    category="Access Control",
                    evidence=output,
                    remediation="FTP sunucusunda anonim erişimi devre dışı bırakın veya SFTP/SCP kullanın.",
                    tool="nmap-nse"
                )
            elif "message_signing: disabled" in output.lower():
                self.store.add_finding(
                    asset_ip=ip,
                    port=port,
                    title="SMB İletişim İmzalama (Signing) Devre Dışı",
                    severity="MEDIUM",
                    category="Network Configuration",
                    evidence=output,
                    remediation="SMB Relay saldırılarını önlemek için SMB Signing özelliğini zorunlu (required) yapın.",
                    tool="nmap-nse"
                )


class DnsAuditModule:
    """dig ve host araçlarını kullanarak PTR ve alan adı DNS kayıtlarını denetler."""

    def __init__(self, store: ResultStore, proc_mgr: ProcessManager, tool_mgr: ToolManager, logger: logging.Logger):
        self.store = store
        self.proc_mgr = proc_mgr
        self.tool_mgr = tool_mgr
        self.logger = logger

    def run(self, target: str, live_ips: List[str]):
        print(f"{Colors.CYAN}[*] DNS ve Ters (PTR) Kayıt Analizi Çalıştırılıyor...{Colors.ENDC}")

        # 1. Hedef bir alan adıysa A, MX, NS, TXT kayıtlarını sorgula
        valid, t_type, _ = ScopeValidator.validate_target(target)
        if valid and t_type == "domain" and self.tool_mgr.is_available("dig"):
            for rtype in ("A", "AAAA", "MX", "NS", "TXT"):
                if self.proc_mgr.is_interrupted:
                    return
                out, _, rc, _ = self.proc_mgr.run_command(
                    module_name="dns_audit",
                    tool_name="dig",
                    cmd=["dig", "+short", target, rtype],
                    timeout=15,
                    raw_category="dns",
                    raw_filename=f"dig_{target}_{rtype}.txt"
                )
                if rc == 0 and out.strip():
                    records = [line.strip() for line in out.splitlines() if line.strip()]
                    for ip in live_ips:
                        self.store.ensure_asset(ip)["dns_records"][rtype] = records

                    if rtype == "TXT":
                        has_spf = any("v=spf1" in r.lower() for r in records)
                        if not has_spf:
                            self.store.add_finding(
                                asset_ip=live_ips[0] if live_ips else target,
                                title=f"Eksik SPF DNS Kaydı ({target})",
                                severity="LOW",
                                category="DNS Security",
                                evidence=f"TXT Kayıtları: {', '.join(records)}",
                                remediation="E-posta sahteciliğini önlemek için alan adına geçerli bir v=spf1 TXT kaydı ekleyin.",
                                tool="dig"
                            )

        # 2. Keşfedilen IP'ler için PTR (Ters DNS) kontrolü
        for ip in live_ips:
            if self.proc_mgr.is_interrupted:
                break
            asset = self.store.ensure_asset(ip)
            if self.tool_mgr.is_available("dig"):
                out, _, rc, _ = self.proc_mgr.run_command(
                    module_name="dns_audit",
                    tool_name="dig",
                    cmd=["dig", "+short", "-x", ip],
                    timeout=10,
                    raw_category="dns",
                    raw_filename=f"ptr_{ip.replace('.', '_')}.txt"
                )
                if rc == 0 and out.strip():
                    ptr_host = out.splitlines()[0].strip().rstrip(".")
                    self.store.upsert_asset(ip=ip, hostname=ptr_host, source="dig-ptr")
                    asset["dns_records"]["PTR"] = ptr_host
            elif self.tool_mgr.is_available("host"):
                out, _, rc, _ = self.proc_mgr.run_command(
                    module_name="dns_audit",
                    tool_name="host",
                    cmd=["host", ip],
                    timeout=10,
                    raw_category="dns",
                    raw_filename=f"host_ptr_{ip.replace('.', '_')}.txt"
                )
                if rc == 0 and "domain name pointer" in out:
                    ptr_host = out.split("domain name pointer")[-1].strip().rstrip(".")
                    self.store.upsert_asset(ip=ip, hostname=ptr_host, source="host-ptr")
                    asset["dns_records"]["PTR"] = ptr_host


class WebAuditModule:
    """Açık HTTP/HTTPS servislerinde başlık denetimi (curl), teknoloji tespiti (whatweb) ve izinliyse nikto çalıştırır."""

    WEB_PORTS = {80, 443, 8080, 8443, 8000, 8008, 8888, 3000, 5000}
    SECURITY_HEADERS = [
        ("Strict-Transport-Security", "LOW", "HTTPS bağlantılarında HSTS başlığı tanımlanmamış."),
        ("X-Frame-Options", "LOW", "Clickjacking koruması için X-Frame-Options (veya CSP frame-ancestors) eksik."),
        ("X-Content-Type-Options", "LOW", "MIME-sniffing koruması için 'X-Content-Type-Options: nosniff' başlığı eksik."),
        ("Content-Security-Policy", "INFO", "İçerik Güvenlik Politikası (CSP) başlığı tespit edilmedi.")
    ]

    def __init__(self, store: ResultStore, proc_mgr: ProcessManager, tool_mgr: ToolManager, logger: logging.Logger):
        self.store = store
        self.proc_mgr = proc_mgr
        self.tool_mgr = tool_mgr
        self.logger = logger

    def run(self, live_ips: List[str], run_nikto: bool = False):
        web_targets: List[Tuple[str, int, str]] = []
        for ip in live_ips:
            asset = self.store.ensure_asset(ip)
            for p in asset["ports"]:
                if p["state"] != "open":
                    continue
                port_num = int(p["port"])
                svc = p["service"].lower()
                if port_num in self.WEB_PORTS or "http" in svc:
                    scheme = "https" if (port_num in {443, 8443} or "https" in svc or "ssl" in svc) else "http"
                    web_targets.append((ip, port_num, scheme))

        if not web_targets:
            return

        print(f"{Colors.CYAN}[*] Web Servis ve Güvenlik Başlığı Denetimi ({len(web_targets)} uç nokta)...{Colors.ENDC}")

        for ip, port, scheme in web_targets:
            if self.proc_mgr.is_interrupted:
                break
            url = f"{scheme}://{ip}:{port}"
            safe_tag = f"{ip.replace('.', '_')}_{port}"
            asset = self.store.ensure_asset(ip)

            # 1. curl ile HTTP Başlık Analizi
            if self.tool_mgr.is_available("curl"):
                out, _, rc, _ = self.proc_mgr.run_command(
                    module_name="web_audit",
                    tool_name="curl",
                    cmd=["curl", "-sS", "-I", "-k", "-L", "--max-time", "10", url],
                    timeout=15,
                    raw_category="web",
                    raw_filename=f"curl_headers_{safe_tag}.txt"
                )
                if rc == 0 and out.strip():
                    headers_lower = out.lower()
                    asset["web_services"].append({
                        "url": url,
                        "tool": "curl",
                        "headers_summary": out.splitlines()[:12]
                    })
                    for hdr, sev, msg in self.SECURITY_HEADERS:
                        if scheme == "http" and hdr == "Strict-Transport-Security":
                            continue
                        if hdr.lower() + ":" not in headers_lower:
                            self.store.add_finding(
                                asset_ip=ip,
                                port=port,
                                title=f"Eksik HTTP Güvenlik Başlığı: {hdr}",
                                severity=sev,
                                category="Web Security Headers",
                                evidence=f"URL: {url}\nAlınan ilk satırlar:\n" + "\n".join(out.splitlines()[:8]),
                                remediation=f"{msg} Web sunucusu yapılandırmasına '{hdr}' başlığını ekleyin.",
                                tool="curl"
                            )

            # 2. whatweb ile kontrollü teknoloji tespiti (--aggression 1: pasif/stealthy)
            if self.tool_mgr.is_available("whatweb"):
                w_out, _, w_rc, _ = self.proc_mgr.run_command(
                    module_name="web_audit",
                    tool_name="whatweb",
                    cmd=["whatweb", "--color=never", "-a", "1", url],
                    timeout=25,
                    raw_category="web",
                    raw_filename=f"whatweb_{safe_tag}.txt"
                )
                if w_rc == 0 and w_out.strip():
                    asset["web_services"].append({
                        "url": url,
                        "tool": "whatweb",
                        "fingerprint": w_out.strip()
                    })

            # 3. nikto (Yalnızca aktif test onayı verilmişse çalışır)
            if run_nikto and self.store.active_tests_authorized and self.tool_mgr.is_available("nikto"):
                print(f"    {Colors.WARNING}[*] Yetkilendirilmiş Nikto denetimi çalışıyor: {url}{Colors.ENDC}")
                n_out, _, _, _ = self.proc_mgr.run_command(
                    module_name="web_audit",
                    tool_name="nikto",
                    cmd=["nikto", "-h", url, "-maxtime", "60s", "-Tuning", "123b", "-nointeractive"],
                    timeout=75,
                    raw_category="web",
                    raw_filename=f"nikto_{safe_tag}.txt"
                )
                if n_out:
                    for line in n_out.splitlines():
                        if line.startswith("+ ") and any(k in line.lower() for k in ("osvdb", "vulnerable", "outdated", "directory indexing")):
                            self.store.add_finding(
                                asset_ip=ip,
                                port=port,
                                title="Nikto Web Yapılandırma Bulgusu",
                                severity="MEDIUM",
                                category="Web Server Audit",
                                evidence=line.strip(),
                                remediation="Nikto çıktısında belirtilen dizin/dosya erişimini kısıtlayın ve sunucu sürümünü güncelleyin.",
                                tool="nikto"
                            )


class TlsAuditModule:
    """Açık TLS/SSL portlarında sertifika geçerliliği ve protokol güvenliğini (testssl.sh veya yerleşik SSL) denetler."""

    TLS_PORTS = {443, 8443, 993, 995, 465, 636}

    def __init__(self, store: ResultStore, proc_mgr: ProcessManager, tool_mgr: ToolManager, logger: logging.Logger):
        self.store = store
        self.proc_mgr = proc_mgr
        self.tool_mgr = tool_mgr
        self.logger = logger

    def run(self, live_ips: List[str]):
        tls_targets: List[Tuple[str, int]] = []
        for ip in live_ips:
            asset = self.store.ensure_asset(ip)
            for p in asset["ports"]:
                if p["state"] != "open":
                    continue
                port_num = int(p["port"])
                svc = p["service"].lower()
                if port_num in self.TLS_PORTS or "ssl" in svc or "https" in svc or "tls" in svc:
                    tls_targets.append((ip, port_num))

        if not tls_targets:
            return

        print(f"{Colors.CYAN}[*] TLS / Sertifika Güvenlik Denetimi ({len(tls_targets)} servis)...{Colors.ENDC}")

        for ip, port in tls_targets:
            if self.proc_mgr.is_interrupted:
                break
            asset = self.store.ensure_asset(ip)
            safe_tag = f"{ip.replace('.', '_')}_{port}"

            # 1. Yerleşik Python SSL ile hızlı protokol ve sertifika kontrolü
            tls_summary = self._inspect_with_python_ssl(ip, port)
            if tls_summary:
                asset["tls_info"].append(tls_summary)

            # 2. testssl.sh kuruluysa kapsamlı kontrol
            if self.tool_mgr.is_available("testssl.sh"):
                binary = self.tool_mgr.get_binary("testssl.sh")
                out, _, _, _ = self.proc_mgr.run_command(
                    module_name="tls_audit",
                    tool_name="testssl.sh",
                    cmd=[binary, "--quiet", "--color", "0", "--protocols", "--server-defaults", f"{ip}:{port}"],
                    timeout=90,
                    raw_category="tls",
                    raw_filename=f"testssl_{safe_tag}.txt"
                )
                if out:
                    for line in out.splitlines():
                        if any(proto in line for proto in ("SSLv2", "SSLv3", "TLS 1.0", "TLS 1.1")) and "offered" in line.lower() and "not offered" not in line.lower():
                            self.store.add_finding(
                                asset_ip=ip,
                                port=port,
                                title="Eski/Güvensiz TLS Protokolü Destekleniyor",
                                severity="MEDIUM",
                                category="TLS Configuration",
                                evidence=line.strip(),
                                remediation="Sunucuda SSLv2, SSLv3, TLS 1.0 ve TLS 1.1 protokollerini devre dışı bırakarak yalnızca TLS 1.2 ve TLS 1.3 kullanın.",
                                tool="testssl.sh"
                            )

    def _inspect_with_python_ssl(self, ip: str, port: int) -> Optional[Dict[str, Any]]:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        try:
            with socket.create_connection((ip, port), timeout=6) as sock:
                with ctx.wrap_socket(sock, server_hostname=ip) as ssock:
                    cipher = ssock.cipher()
                    tls_ver = ssock.version()
                    info = {
                        "port": port,
                        "protocol_version": tls_ver,
                        "cipher_suite": cipher[0] if cipher else "Bilinmiyor",
                        "cipher_bits": cipher[2] if cipher else 0
                    }
                    if tls_ver in ("SSLv2", "SSLv3", "TLSv1", "TLSv1.1"):
                        self.store.add_finding(
                            asset_ip=ip,
                            port=port,
                            title=f"Zayıf TLS Sürümü Müzakere Edildi ({tls_ver})",
                            severity="MEDIUM",
                            category="TLS Configuration",
                            evidence=f"{ip}:{port} bağlantısında {tls_ver} ({info['cipher_suite']}) kullanıldı.",
                            remediation=" yalnızca TLSv1.2 ve TLSv1.3 protokollerine izin verecek şekilde yapılandırın.",
                            tool="python-ssl"
                        )
                    return info
        except Exception as exc:
            self.logger.debug(f"TLS bağlantı kontrolü başarısız ({ip}:{port}): {exc}")
            return None


class VulnerabilityAuditModule:
    """Açık port/servis korelasyonu ile riskli servisleri tespit eder ve OpenVAS/GVM hazırlığını kontrol eder."""

    RISKY_PORTS = {
        21: ("FTP Servisi Açık (Şifresiz İletişim Riski)", "LOW", "Dosya transferi için düz metin FTP yerine SFTP veya FTPS tercih edin."),
        23: ("Telnet Servisi Açık (Düz Metin Kimlik Bilgisi)", "HIGH", "Telnet servisini derhal kapatın ve uzaktan yönetim için yalnızca SSH kullanın."),
        445: ("SMB Dosya Paylaşım Portu Erişilebilir", "INFO", "SMB servisinin yalnızca yetkili alt ağlardan erişilebilir olduğunu ve güncel yamaların uygulandığını doğrulayın."),
        3389: ("RDP (Uzak Masaüstü) Servisi Açık", "LOW", "RDP erişimini VPN arkasına alın, NLA (Network Level Authentication) ve güçlü parola politikası uygulayın."),
        6379: ("Redis Veritabanı Portu Ağdan Erişilebilir", "HIGH", "Redis servisini localhost'a bağlayın (bind 127.0.0.1) ve kimlik doğrulamayı (requirepass/ACL) zorunlu kılın.")
    }

    def __init__(self, store: ResultStore, tool_mgr: ToolManager, logger: logging.Logger):
        self.store = store
        self.tool_mgr = tool_mgr
        self.logger = logger

    def run(self, live_ips: List[str]):
        for ip in live_ips:
            asset = self.store.ensure_asset(ip)
            for p in asset["ports"]:
                if p["state"] != "open":
                    continue
                port_num = int(p["port"])
                svc_desc = f"{p['service']} {p['product']} {p['version']}".strip()
                if port_num in self.RISKY_PORTS:
                    title, sev, rem = self.RISKY_PORTS[port_num]
