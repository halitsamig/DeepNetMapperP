# 3. CORE: MERKEZİ VERİ DEPOSU VE KORELASYON (core/result_store.py)
# =====================================================================
class ResultStore:
    """
    Tüm modüllerin bulgularını, varlık envanterini, görev durumlarını ve
    hataları merkezi olarak tekilleştirerek (deduplication) saklar.
    """

    def __init__(self, base_scans_dir: str, target: str, profile_name: str, speed_name: str):
        self.start_time = datetime.now()
        self.end_time: Optional[datetime] = None
        self.timestamp = self.start_time.strftime("%Y%m%d_%H%M%S")
        safe_target = re.sub(r"[^A-Za-z0-9_.-]", "_", target)[:30]
        self.scan_id = f"{self.timestamp}_{safe_target}"
        self.scan_dir = os.path.join(base_scans_dir, self.scan_id)

        # Alt klasör yapısı
        self.logs_dir = os.path.join(self.scan_dir, "logs")
        self.raw_dirs = {
            "nmap": os.path.join(self.scan_dir, "raw", "nmap"),
            "dns": os.path.join(self.scan_dir, "raw", "dns"),
            "web": os.path.join(self.scan_dir, "raw", "web"),
            "tls": os.path.join(self.scan_dir, "raw", "tls"),
        }
        self._init_directories()

        self.target = target
        self.profile_name = profile_name
        self.speed_name = speed_name
        self.status = "BAŞLATILDI"
        self.active_tests_authorized = False

        # Veri yapıları
        self.assets: Dict[str, Dict[str, Any]] = {}
        self.findings: List[Dict[str, Any]] = []
        self.tasks: List[Dict[str, Any]] = []
        self.errors: List[Dict[str, Any]] = []
        self.environment_info: Dict[str, Any] = {
            "interfaces": [],
            "routes": [],
            "wifi_networks": [],
            "tools": {}
        }

    def _init_directories(self):
        os.makedirs(self.logs_dir, exist_ok=True)
        for d in self.raw_dirs.values():
            os.makedirs(d, exist_ok=True)

    def rel_path(self, abs_path: str) -> str:
        try:
            return os.path.relpath(abs_path, self.scan_dir)
        except ValueError:
            return abs_path

    def ensure_asset(self, ip: str) -> Dict[str, Any]:
        if ip not in self.assets:
            self.assets[ip] = {
                "ip": ip,
                "hostname": "Bilinmiyor",
                "hostnames": [],
                "status": "up",
                "mac": "Bilinmiyor",
                "vendor": "Bilinmiyor",
                "discovery_sources": [],
                "os_matches": [],
                "ports": [],
                "scripts": [],
                "dns_records": {},
                "web_services": [],
                "tls_info": [],
                "traceroute": [],
                "scan_completed": False,
                "partial_recovery": False
            }
        return self.assets[ip]

    def upsert_asset(
        self,
        ip: str,
        hostname: Optional[str] = None,
        mac: Optional[str] = None,
        vendor: Optional[str] = None,
        source: Optional[str] = None
    ):
        """Aynı IP farklı araçlarla bulunduğunda bilgileri tek varlık altında birleştirir."""
        asset = self.ensure_asset(ip)
        if hostname and hostname != "Bilinmiyor":
            if asset["hostname"] == "Bilinmiyor":
                asset["hostname"] = hostname
            if hostname not in asset["hostnames"]:
                asset["hostnames"].append(hostname)
        if mac and mac != "Bilinmiyor":
            asset["mac"] = mac.upper()
        if vendor and vendor != "Bilinmiyor":
            asset["vendor"] = vendor
        if source and source not in asset["discovery_sources"]:
            asset["discovery_sources"].append(source)

    def upsert_port(
        self,
        ip: str,
        port: int,
        protocol: str = "tcp",
        state: str = "open",
        service: str = "bilinmiyor",
        product: str = "",
        version: str = "",
        extrainfo: str = "",
        source: str = "nmap",
        evidence: str = ""
    ):
        """Aynı IP/port/protokol kaydını tekilleştirir; yeni servis/kanıt bilgilerini mevcut kayda ekler."""
        asset = self.ensure_asset(ip)
        port_num = int(port)
        proto = protocol.lower()

        existing = None
        for p in asset["ports"]:
            if int(p["port"]) == port_num and p["protocol"].lower() == proto:
                existing = p
                break

        if existing is None:
            new_entry = {
                "port": port_num,
                "protocol": proto,
                "state": state,
                "service": service or "bilinmiyor",
                "product": product or "",
                "version": version or "",
                "extrainfo": extrainfo or "",
                "sources": [source] if source else [],
                "evidence": [evidence] if evidence else []
            }
            asset["ports"].append(new_entry)
            asset["ports"].sort(key=lambda x: (x["port"], x["protocol"]))
        else:
            if state and existing["state"] in ("bilinmiyor", "unknown"):
                existing["state"] = state
            if service and service != "bilinmiyor" and existing["service"] == "bilinmiyor":
                existing["service"] = service
            if product and not existing["product"]:
                existing["product"] = product
            if version and not existing["version"]:
                existing["version"] = version
            if extrainfo and not existing["extrainfo"]:
                existing["extrainfo"] = extrainfo
            if source and source not in existing["sources"]:
                existing["sources"].append(source)
            if evidence and evidence not in existing["evidence"]:
                existing["evidence"].append(evidence)

    def add_finding(
        self,
        asset_ip: str,
        title: str,
        severity: str,
        category: str,
        evidence: str,
        remediation: str,
        port: Optional[int] = None,
        tool: str = "nmap"
    ):
        """Güvenlik ve yapılandırma bulgularını tekilleştirerek ekler."""
        severity = severity.upper()
        if severity not in {"CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"}:
            severity = "INFO"

        for f in self.findings:
            if (
                f["asset_ip"] == asset_ip
                and f["port"] == port
                and f["title"] == title
                and f["category"] == category
            ):
                if evidence and evidence not in f["evidence"]:
                    f["evidence"] += f"\n---\n{evidence}"
                return

        self.findings.append({
            "id": f"FND-{len(self.findings) + 1:04d}",
            "asset_ip": asset_ip,
            "port": port,
            "title": title,
            "severity": severity,
            "category": category,
            "tool": tool,
            "evidence": evidence.strip() if evidence else "Kanıt metni yok",
            "remediation": remediation,
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        })

    def record_task(
        self,
        module: str,
        tool: str,
        command: List[str],
        status: str,
        returncode: Optional[int],
        duration_sec: float,
        raw_output_path: Optional[str] = None,
        error_msg: str = ""
    ):
        self.tasks.append({
            "module": module,
            "tool": tool,
            "command": " ".join(command),
            "status": status,  # COMPLETED, FAILED, TIMEOUT, INTERRUPTED, SKIPPED
            "returncode": returncode,
            "duration_sec": round(duration_sec, 2),
            "raw_file": self.rel_path(raw_output_path) if raw_output_path else None,
            "error": error_msg,
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        })

    def record_error(self, module: str, message: str, exception_text: str = ""):
        self.errors.append({
            "module": module,
            "message": message,
            "exception": exception_text,
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        })


