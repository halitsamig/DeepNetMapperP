    def _setup_file_logger(self):
        if not self.store:
            return
        log_file = os.path.join(self.store.logs_dir, "scan.log")
        fh = logging.FileHandler(log_file, encoding="utf-8")
        fh.setLevel(logging.DEBUG)
        fh.setFormatter(logging.Formatter("%(asctime)s [%(levelname)s] %(message)s"))
        self.logger.addHandler(fh)

    def _signal_handler(self, signum, frame):
        """Ctrl+C veya SIGTERM geldiğinde aktif süreci durdurur, XML verilerini kurtarır ve KISMİ rapor üretir."""
        if self.proc_mgr and self.proc_mgr.is_interrupted:
            return
        print(f"\n\n{Colors.WARNING}{Colors.BOLD}[!] KESİNTİ SİNYALİ ALINDI (Ctrl+C)!{Colors.ENDC}")
        print(f"{Colors.CYAN}[*] Aktif alt süreç sonlandırılıyor ve kısmi sonuçlar kurtarılıyor...{Colors.ENDC}")

        if self.proc_mgr:
            self.proc_mgr.is_interrupted = True
            self.proc_mgr.terminate_active_process()

        if self.nmap_mod:
            self.nmap_mod.recover_all_pending_xmls()

        if self.report_engine:
            self.report_engine.save_all(final_status="KESİLDİ (KISMİ SONUÇLAR)")

        sys.exit(130)

    def check_environment_and_tools(self):
        if hasattr(os, "geteuid") and os.geteuid() != 0 and not self.args.unprivileged:
            print(f"{Colors.FAIL}[!] HATA: SYN taraması (-sS), OS tespiti (-O) ve ARP keşfi için 'sudo' gereklidir.{Colors.ENDC}")
            print(f"{Colors.WARNING}    Örnek: sudo python3 {sys.argv[0]} (veya yetkisiz mod için --unprivileged){Colors.ENDC}")
            sys.exit(1)

        inventory = self.tool_mgr.check_all_tools()
        print(f"\n{Colors.BOLD}[*] Kali Araç Yöneticisi Denetimi:{Colors.ENDC}")
        for name, info in inventory.items():
            if info["installed"]:
                print(f"    {Colors.GREEN}[✓] {name:<12}{Colors.ENDC} : {info['version']}")
            else:
                tag = "ZORUNLU" if info["required"] else "İsteğe Bağlı"
                color = Colors.FAIL if info["required"] else Colors.WARNING
                print(f"    {color}[!] {name:<12}{Colors.ENDC} : Kurulu Değil ({tag} - {info['description']})")

        if not self.tool_mgr.is_available("nmap"):
            print(f"\n{Colors.FAIL}[!] Kritik bağımlılık eksik: 'nmap' kurulu olmadan devam edilemez.{Colors.ENDC}")
            sys.exit(1)

    def interactive_setup(self):
        """Eksik parametreleri kullanıcıdan doğrulanmış menü adımlarıyla alır."""
        # 1. Hedef Seçimi ve Doğrulaması
        while True:
            if not self.target:
                print(f"\n{Colors.BOLD}[1] Hedef Kapsam (Scope) Belirleme:{Colors.ENDC}")
                print("    [A] Yerel Arayüz ve Alt Ağları Listele (Otomatik Keşif)")
                print("    [B] Manuel IP, CIDR veya Alan Adı Gir (örn: 192.168.1.0/24)")
                choice = input(f"{Colors.GREEN}>>> Seçiminiz (A/B, Varsayılan: A): {Colors.ENDC}").strip().upper()

                if choice == "B":
                    self.target = input(f"{Colors.GREEN}>>> Hedef IP / CIDR / Alan Adı: {Colors.ENDC}").strip()
                else:
                    self.target = self._select_from_local_environment()
                    if not self.target:
                        self.target = input(f"{Colors.GREEN}>>> Manuel Hedef IP / CIDR / Alan Adı: {Colors.ENDC}").strip()

            valid, t_type, desc = ScopeValidator.validate_target(self.target)
            if valid:
                print(f"{Colors.GREEN}[✓] Hedef Doğrulandı: {self.target} -> {desc}{Colors.ENDC}")
                break
            else:
                print(f"{Colors.FAIL}[!] Geçersiz Hedef: {desc}{Colors.ENDC}")
                self.target = None

        # 2. Profil Seçimi
        if not self.profile_choice or self.profile_choice not in self.SCAN_PROFILES:
            print(f"\n{Colors.BOLD}[2] Tarama Profili Seçin:{Colors.ENDC}")
            for k, v in self.SCAN_PROFILES.items():
                print(f"    [{k}] {v['name']}")
            p_in = input(f"{Colors.GREEN}>>> Seçiminiz (1-5, Varsayılan: 2): {Colors.ENDC}").strip()
            self.profile_choice = p_in if p_in in self.SCAN_PROFILES else "2"

        # Özel Profil (Profil 5) yapılandırması
        if self.profile_choice == "5":
            self._configure_custom_profile()

        # 3. Hız Seçimi
        if not self.speed_choice or self.speed_choice not in self.SPEED_PROFILES:
            print(f"\n{Colors.BOLD}[3] Tarama Hızı Seçin:{Colors.ENDC}")
            for k, v in self.SPEED_PROFILES.items():
                print(f"    [{k}] {v['name']}")
            s_in = input(f"{Colors.GREEN}>>> Seçiminiz (1-4, Varsayılan: 2 - Dengeli): {Colors.ENDC}").strip()
            self.speed_choice = s_in if s_in in self.SPEED_PROFILES else "2"

        if self.speed_choice == "4":
            min_rate = input(f"{Colors.GREEN}>>> Minimum Paket/Saniye (--min-rate, örn: 400): {Colors.ENDC}").strip()
            if min_rate.isdigit() and int(min_rate) > 0:
                self.SPEED_PROFILES["4"]["flags"].extend(["--min-rate", min_rate])

        # 4. Aktif / Yoğun Test İzni Kontrolü
        selected_profile = self.SCAN_PROFILES[self.profile_choice]
        if selected_profile["requires_active_auth"] and not self.allow_active:
            print(f"\n{Colors.WARNING}[!] Güvenlik Uyarısı: Seçilen profil aktif güvenlik/zafiyet kontrolleri (NSE vuln / Nikto) içerir.{Colors.ENDC}")
            confirm = input(f"{Colors.GREEN}>>> '{self.target}' hedefinde aktif test 권한/izniniz var mı? (E/H, Varsayılan: H): {Colors.ENDC}").strip().upper()
            self.allow_active = (confirm == "E")
            if not self.allow_active:
                print(f"{Colors.CYAN}[i] Aktif test izni onaylanmadı; yalnızca güvenli (safe/default) kontroller çalıştırılacak.{Colors.ENDC}")
                self.SCAN_PROFILES["4"]["nmap_flags"] = ["-sS", "-sV", "-O", "--script=default,safe", "--traceroute"]

    def _select_from_local_environment(self) -> Optional[str]:
        """Yerel alt ağları listeler, Wi-Fi SSID'lerini bilgi olarak gösterir ama yalnızca geçerli alt ağları hedef yapar."""
        subnets = []
        try:
            proc = subprocess.run(["ip", "-o", "-4", "addr", "show"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
            for line in proc.stdout.splitlines():
                parts = line.split()
                if len(parts) >= 4 and parts[1] != "lo" and "/" in parts[3]:
                    net = str(ipaddress.ip_network(parts[3], strict=False))
                    subnets.append({"iface": parts[1], "ip": parts[3], "cidr": net})
        except Exception:
            pass

        if not subnets:
            print(f"{Colors.WARNING}[!] Aktif yerel alt ağ bulunamadı.{Colors.ENDC}")
            return None

        print(f"\n{Colors.GREEN}{Colors.BOLD}[+] Tespit Edilen Yerel Ağ Arayüzleri:{Colors.ENDC}")
        for idx, item in enumerate(subnets, start=1):
            print(f"    [{idx}] Arayüz: {Colors.BOLD}{item['iface']:<10}{Colors.ENDC} | Cihaz IP: {item['ip']:<18} | Hedef CIDR: {Colors.CYAN}{item['cidr']}{Colors.ENDC}")
        print("    [0] Manuel Hedef Girmek İstiyorum")

        sel = input(f"\n{Colors.GREEN}>>> Taranacak Alt Ağ Numarasını Seçin: {Colors.ENDC}").strip()
        if sel.isdigit() and 1 <= int(sel) <= len(subnets):
            return subnets[int(sel) - 1]["cidr"]
        return None

    def _configure_custom_profile(self):
        ports = self.args.ports
        if not ports:
            ports = input(f"{Colors.GREEN}>>> Port Aralığı (örn: 22,80,443,1000-2000 veya tümü için -p-): {Colors.ENDC}").strip()
        if ports == "-p-":
            self.SCAN_PROFILES["5"]["nmap_flags"].append("-p-")
        elif ScopeValidator.validate_port_spec(ports):
            self.SCAN_PROFILES["5"]["nmap_flags"].extend(["-p", ports])
        else:
            print(f"{Colors.WARNING}[i] Geçersiz veya boş port aralığı; varsayılan yaygın portlar taranacak.{Colors.ENDC}")

    def run(self):
        self.print_banner()
        self.check_environment_and_tools()
        self.interactive_setup()

        profile = self.SCAN_PROFILES[self.profile_choice]
        speed = self.SPEED_PROFILES[self.speed_choice]

        # Merkezi veri deposu ve süreç yöneticisini başlat
        self.store = ResultStore(
            base_scans_dir=self.base_scans_dir,
            target=self.target,
            profile_name=profile["name"],
            speed_name=speed["name"]
        )
        self.store.active_tests_authorized = self.allow_active
        self.store.environment_info["tools"] = self.tool_mgr.inventory
        self._setup_file_logger()

        self.proc_mgr = ProcessManager(self.store, self.logger)
        self.report_engine = ReportEngine(self.store, self.logger)

        # Modülleri hazırla
        discovery_mod = DiscoveryModule(self.store, self.proc_mgr, self.tool_mgr, self.logger)
        self.nmap_mod = NmapScannerModule(self.store, self.proc_mgr, self.tool_mgr, self.logger)
        dns_mod = DnsAuditModule(self.store, self.proc_mgr, self.tool_mgr, self.logger)
        web_mod = WebAuditModule(self.store, self.proc_mgr, self.tool_mgr, self.logger)
        tls_mod = TlsAuditModule(self.store, self.proc_mgr, self.tool_mgr, self.logger)
        vuln_mod = VulnerabilityAuditModule(self.store, self.tool_mgr, self.logger)

        print(f"\n{Colors.CYAN}{Colors.BOLD}[AŞAMA 1] Ortam Analizi ve Canlı Cihaz Keşfi Başlatılıyor...{Colors.ENDC}")
        discovery_mod.inspect_local_environment()
        discovery_mod.run_arp_scan(self.target)
        live_ips = self.nmap_mod.discover_live_hosts(self.target)

        if not live_ips:
            print(f"{Colors.WARNING}[!] Hedef kapsamda ({self.target}) aktif cihaz bulunamadı.{Colors.ENDC}")
            self.report_engine.save_all(final_status="AKTİF CİHAZ BULUNAMADI")
            return

        print(f"{Colors.GREEN}[+] Toplam {len(live_ips)} aktif cihaz tespit edildi:{Colors.ENDC}")
        for ip in live_ips:
            asset = self.store.ensure_asset(ip)
            mac_str = f" [{asset['mac']} - {asset['vendor']}]" if asset["mac"] != "Bilinmiyor" else ""
            print(f"    └── {Colors.BOLD}{ip}{Colors.ENDC}{mac_str}")

        # Aşama 2: Nmap Profil Taraması
        self.nmap_mod.scan_hosts(
            live_ips=live_ips,
            profile_flags=profile["nmap_flags"],
            speed_flags=speed["flags"],
            host_timeout_sec=self.host_timeout_sec
        )

        # Aşama 3: Ek Denetim Modülleri (DNS, Web, TLS, Zafiyet Korelasyonu)
        if profile["run_dns"] and not self.proc_mgr.is_interrupted:
            dns_mod.run(self.target, live_ips)

        if profile["run_web"] and not self.proc_mgr.is_interrupted:
            web_mod.run(live_ips, run_nikto=(self.profile_choice == "4" and self.allow_active))

        if profile["run_tls"] and not self.proc_mgr.is_interrupted:
            tls_mod.run(live_ips)

        if profile["run_vuln"] and not self.proc_mgr.is_interrupted:
            vuln_mod.run(live_ips)

        # Sonuç durumunu belirle ve kaydet
        has_failed_tasks = any(t["status"] in ("FAILED", "TIMEOUT") for t in self.store.tasks)
        final_status = "KISMİ TAMAMLANDI (BAZI GÖREVLERDE HATA/ZAMAN AŞIMI)" if has_failed_tasks else "TAMAMLANDI"
        self.report_engine.save_all(final_status=final_status)


def initialize_project_structure(base_dir: str = "DeepNetMapper-Pro"):
    """Hedef mimarideki klasör ve yapılandırma dosyalarını (config/, core/, modules/, scans/) oluşturur."""
    dirs = [
        os.path.join(base_dir, "config"),
        os.path.join(base_dir, "core"),
        os.path.join(base_dir, "modules"),
        os.path.join(base_dir, "scans")
    ]
    for d in dirs:
        os.makedirs(d, exist_ok=True)

    settings_path = os.path.join(base_dir, "config", "settings.json")
    if not os.path.exists(settings_path):
        with open(settings_path, "w", encoding="utf-8") as f:
            json.dump({
                "default_output_dir": "scans",
                "default_host_timeout_sec": 600,
                "require_root_by_default": True,
                "safe_defaults": {"allow_active_tests": False}
            }, f, indent=2, ensure_ascii=False)

    profiles_path = os.path.join(base_dir, "config", "profiles.json")
    if not os.path.exists(profiles_path):
        with open(profiles_path, "w", encoding="utf-8") as f:
            json.dump({
                "scan_profiles": DeepNetMapperPro.SCAN_PROFILES,
                "speed_profiles": DeepNetMapperPro.SPEED_PROFILES
            }, f, indent=2, ensure_ascii=False)

    print(f"{Colors.GREEN}[✓] '{base_dir}/' proje dizin yapısı ve config dosyaları oluşturuldu.{Colors.ENDC}")


