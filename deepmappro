# 4. CORE: SÜREÇ YÖNETİCİSİ (core/process_manager.py)
# =====================================================================
class ProcessManager:
    """
    Alt süreçleri güvenli argüman dizileriyle çalıştırır, zaman aşımı ve Ctrl+C
    kesintilerini yönetir, ham çıktıları raw/ dizinine yazar.
    """

    def __init__(self, store: ResultStore, logger: logging.Logger):
        self.store = store
        self.logger = logger
        self.current_process: Optional[subprocess.Popen] = None
        self.is_interrupted = False

    def terminate_active_process(self):
        """Aktif alt süreci güvenli biçimde sonlandırır ve dosya tamponlarının yazılmasını bekler."""
        proc = self.current_process
        if proc and proc.poll() is None:
            self.logger.warning(f"Aktif alt süreç sonlandırılıyor (PID: {proc.pid})...")
            try:
                proc.terminate()
                proc.wait(timeout=4)
            except subprocess.TimeoutExpired:
                self.logger.warning(f"PID {proc.pid} terminate süresinde kapanmadı, kill gönderiliyor.")
                try:
                    proc.kill()
                    proc.wait(timeout=2)
                except Exception as exc:
                    self.logger.error(f"Süreç sonlandırma hatası: {exc}")
            except Exception as exc:
                self.logger.error(f"Süreç durdurulurken hata: {exc}")
        time.sleep(0.25)

    def run_command(
        self,
        module_name: str,
        tool_name: str,
        cmd: List[str],
        timeout: int = 120,
        raw_category: Optional[str] = None,
        raw_filename: Optional[str] = None,
        stream_output: bool = False
    ) -> Tuple[str, str, int, str]:
        """
        Komutu çalıştırır ve (stdout, stderr, returncode, status) döndürür.
        status: COMPLETED | FAILED | TIMEOUT | INTERRUPTED
        """
        if self.is_interrupted:
            return "", "", -1, "INTERRUPTED"

        start_t = time.time()
        raw_path = None
        if raw_category and raw_filename and raw_category in self.store.raw_dirs:
            raw_path = os.path.join(self.store.raw_dirs[raw_category], raw_filename)

        self.logger.info(f"[{module_name}] Komut başlatılıyor: {' '.join(cmd)}")
        stdout_lines: List[str] = []
        stderr_data = ""
        returncode = -1
        status = "FAILED"

        try:
            if stream_output:
                self.current_process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1
                )
                if self.current_process.stdout:
                    for line in self.current_process.stdout:
                        stdout_lines.append(line)
                        line_str = line.strip()
                        if any(k in line_str for k in ("Stats:", "Timing:", "Discovered open port", "Completed")):
                            print(f"    {Colors.CYAN}↳ {line_str}{Colors.ENDC}")
                        if time.time() - start_t > timeout:
                            self.terminate_active_process()
                            status = "TIMEOUT"
                            break
                        if self.is_interrupted:
                            status = "INTERRUPTED"
                            break

                self.current_process.wait(timeout=5)
                returncode = self.current_process.returncode if self.current_process.returncode is not None else -1
                stdout_data = "".join(stdout_lines)
                if status not in ("TIMEOUT", "INTERRUPTED"):
                    status = "COMPLETED" if returncode == 0 else "FAILED"
            else:
                self.current_process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True
                )
                stdout_data, stderr_data = self.current_process.communicate(timeout=timeout)
                returncode = self.current_process.returncode
                if self.is_interrupted:
                    status = "INTERRUPTED"
                else:
                    status = "COMPLETED" if returncode == 0 else "FAILED"

        except subprocess.TimeoutExpired:
            self.terminate_active_process()
            stdout_data = "".join(stdout_lines)
            status = "TIMEOUT"
            self.store.record_error(module_name, f"{tool_name} zaman aşımına uğradı ({timeout}s)")
            self.logger.warning(f"[{module_name}] Zaman aşımı ({timeout}s): {' '.join(cmd)}")
        except Exception as exc:
            stdout_data = "".join(stdout_lines)
            stderr_data = str(exc)
            status = "FAILED"
            self.store.record_error(module_name, f"{tool_name} çalıştırma hatası", str(exc))
            self.logger.error(f"[{module_name}] Çalıştırma hatası: {exc}")
        finally:
            self.current_process = None

        duration = time.time() - start_t

        if raw_path:
            try:
                with open(raw_path, "w", encoding="utf-8", errors="replace") as rf:
                    rf.write(f"# Command: {' '.join(cmd)}\n")
                    rf.write(f"# Status: {status} | ReturnCode: {returncode} | Duration: {duration:.2f}s\n\n")
                    rf.write(stdout_data or "")
                    if stderr_data:
                        rf.write("\n--- STDERR ---\n" + stderr_data)
            except Exception as exc:
                self.logger.error(f"Ham çıktı dosyası yazılamadı ({raw_path}): {exc}")

        self.store.record_task(
            module=module_name,
            tool=tool_name,
            command=cmd,
            status=status,
            returncode=returncode,
            duration_sec=duration,
            raw_output_path=raw_path,
            error_msg=stderr_data.strip()[:300] if status != "COMPLETED" else ""
        )

        return stdout_data, stderr_data, returncode, status


