    }

    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.target: Optional[str] = args.target
        self.profile_choice: Optional[str] = args.profile
        self.speed_choice: Optional[str] = args.speed
        self.base_scans_dir: str = args.output
        self.allow_active: bool = args.allow_active
        self.host_timeout_sec: int = args.timeout

        # Geçici konsol loglayıcı (ResultStore açılınca dosya handler eklenir)
        self.logger = logging.getLogger("DeepNetMapperPro")
        self.logger.setLevel(logging.DEBUG)
        self.store: Optional[ResultStore] = None
        self.proc_mgr: Optional[ProcessManager] = None
        self.tool_mgr = ToolManager(self.logger)
        self.nmap_mod: Optional[NmapScannerModule] = None
        self.report_engine: Optional[ReportEngine] = None

        signal.signal(signal.SIGINT, self._signal_handler)
        signal.signal(signal.SIGTERM, self._signal_handler)

