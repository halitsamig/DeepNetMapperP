class ToolManager:
    """Kali araçlarının kurulu olup olmadığını, sürümlerini ve parametre uyumluluğunu denetler."""

    TOOL_DEFINITIONS = {
        "nmap": {"required": True, "version_args": ["nmap", "--version"], "desc": "Canlı cihaz, port, servis ve OS keşfi"},
        "ip": {"required": True, "version_args": ["ip", "-V"], "desc": "Yerel arayüzler ve yönlendirme bilgileri"},
        "arp-scan": {"required": False, "version_args": ["arp-scan", "--version"], "desc": "Katman-2 yerel Ethernet cihaz keşfi"},
        "nmcli": {"required": False, "version_args": ["nmcli", "--version"], "desc": "Kablosuz ağ ve arayüz bilgisi"},
        "dig": {"required": False, "version_args": ["dig", "-v"], "desc": "DNS kayıtlarının incelenmesi"},
        "host": {"required": False, "version_args": ["host", "-V"], "desc": "Hızlı DNS/PTR sorguları"},
        "curl": {"required": False, "version_args": ["curl", "--version"], "desc": "HTTP başlıkları ve erişilebilirlik kontrolleri"},
        "testssl.sh": {"required": False, "alt_names": ["testssl"], "version_args": ["--version"], "desc": "TLS yapılandırması ve sertifika denetimi"},
        "whatweb": {"required": False, "version_args": ["whatweb", "--version"], "desc": "Web teknolojilerinin tanımlanması"},
        "nikto": {"required": False, "version_args": ["nikto", "-Version"], "desc": "Web sunucusu yapılandırma denetimleri"},
        "gvm-cli": {"required": False, "alt_names": ["omp"], "version_args": ["--version"], "desc": "Greenbone/OpenVAS zafiyet tarama entegrasyonu"}
    }

    def __init__(self, logger: logging.Logger):
        self.logger = logger
        self.inventory: Dict[str, Dict[str, Any]] = {}

    def check_all_tools(self) -> Dict[str, Dict[str, Any]]:
        """Tüm araçların varlığını ve sürüm bilgilerini kontrol eder."""
        for name, meta in self.TOOL_DEFINITIONS.items():
            binary_path = shutil.which(name)
            resolved_name = name
            if not binary_path and "alt_names" in meta:
                for alt in meta["alt_names"]:
                    binary_path = shutil.which(alt)
                    if binary_path:
                        resolved_name = alt
                        break

            installed = binary_path is not None
            version_str = "Kurulu Değil"
            if installed:
                version_str = self._extract_version(resolved_name, meta.get("version_args", [resolved_name, "--version"]))

            self.inventory[name] = {
                "name": name,
                "resolved_binary": resolved_name if installed else None,
                "path": binary_path,
                "installed": installed,
                "required": meta["required"],
                "version": version_str,
                "description": meta["desc"]
            }
            if not installed and meta["required"]:
                self.logger.error(f"Zorunlu araç eksik: {name}")
            elif not installed:
                self.logger.info(f"İsteğe bağlı araç kurulu değil: {name}")

        return self.inventory

    def _extract_version(self, binary: str, args: List[str]) -> str:
        cmd = [binary] + args[1:] if args and args[0] != binary else args
        try:
            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=4)
            output = (proc.stdout or "") + "\n" + (proc.stderr or "")
            for line in output.splitlines():
                clean = line.strip()
                if clean:
                    return clean[:80]
        except Exception as exc:
            self.logger.debug(f"{binary} sürüm bilgisi alınamadı: {exc}")
        return "Sürüm Belirlenemedi"

    def is_available(self, tool_name: str) -> bool:
        return bool(self.inventory.get(tool_name, {}).get("installed"))

    def get_binary(self, tool_name: str) -> str:
        info = self.inventory.get(tool_name, {})
        return info.get("resolved_binary") or tool_name

    @staticmethod
    def resolve_nmap_flags(profile_flags: List[str], speed_flags: List[str], is_root: bool = True) -> List[str]:
        """
        Nmap profil ve hız bayraklarını birleştirirken çakışmaları önler.
        Örn: -sn ile port tarama bayrakları (-sS, -sV, -O, -p-) bir arada kullanılamaz.
        """
        combined = list(profile_flags)
        is_ping_only = "-sn" in combined

        if is_ping_only:
            forbidden_with_sn = {"-sS", "-sT", "-sU", "-sV", "-O", "-sC", "-p-", "-f"}
            cleaned = []
            skip_next = False
            for idx, flag in enumerate(combined):
                if skip_next:
                    skip_next = False
                    continue
                if flag in forbidden_with_sn or flag.startswith("--script"):
                    continue
                if flag in {"--top-ports", "-p", "--data-length"}:
                    skip_next = True
                    continue
                cleaned.append(flag)
            combined = cleaned

        if not is_root:
            combined = ["-sT" if f == "-sS" else f for f in combined if f != "-O"]

        # Zamanlama bayrağı (-T0 .. -T5) tekilleştirme: Hız profilindeki değer önceliklidir
        speed_timing = [f for f in speed_flags if re.match(r"^-T[0-5]$", f)]
        if speed_timing:
            combined = [f for f in combined if not re.match(r"^-T[0-5]$", f)]

        for s_flag in speed_flags:
            if s_flag not in combined:
                combined.append(s_flag)

        return combined


